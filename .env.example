# Скопируйте в .env и заполните своими значениями
POSTGRES_USER=walletly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=walletly
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Секрет подписи JWT. Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me

# Адрес приложения для ссылок в письмах
APP_URL=http://localhost:8080

# Почта. Если SMTP_HOST пуст, письма печатаются в лог контейнера api
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Walletly <noreply@example.com>

# ЮKassa: ключи тестового магазина, боевые подставляются после договора.
# Уведомления настраиваются в кабинете на https://ваш-домен/api/billing/yookassa/webhook
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PREMIUM_PRICE_RUB=299

# Telegram-бот: токен и имя выдаёт @BotFather. Пусто — бот выключен
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Для сервера: домен и пароль Grafana (docs/deploy.md)
# DOMAIN=example.ru
# GRAFANA_PASSWORD=
# BACKUP_KEEP_DAYS=14

# Порты на компьютере: поменяйте, если заняты другими проектами
API_PORT=8000
WEB_PORT=8080
